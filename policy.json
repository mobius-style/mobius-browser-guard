{
  "version": "0.3.1",
  "frozen": false,
  "domain_allowlist": ["example.com", "localhost", "127.0.0.1"],
  "navigate_offlist_decision": "ask",
  "navigate_payload_char_limit": 256,
  "computer_read_actions": ["screenshot", "wait", "scroll", "zoom", "scroll_to", "hover"],
  "computer_act_decision": "ask",
  "tiers": {
    "read_page":              {"decision": "allow", "reason": "read-only (writes:0)"},
    "get_page_text":          {"decision": "allow", "reason": "read-only (writes:0)"},
    "find":                   {"decision": "allow", "reason": "read-only (writes:0)"},
    "read_console_messages":  {"decision": "allow", "reason": "read-only (writes:0)"},
    "read_network_requests":  {"decision": "allow", "reason": "read-only (writes:0); note: can surface bearer tokens, which are capabilities rather than mere data"},
    "tabs_context_mcp":       {"decision": "allow", "reason": "read-only (writes:0)"},
    "list_connected_browsers":{"decision": "allow", "reason": "read-only (writes:0)"},
    "shortcuts_list":         {"decision": "allow", "reason": "read-only (writes:0)"},
    "tabs_create_mcp":        {"decision": "allow", "reason": "window mgmt (writes:1); sound only while the tool takes no url argument"},
    "tabs_close_mcp":         {"decision": "allow", "reason": "window mgmt (writes:1)"},
    "resize_window":          {"decision": "allow", "reason": "window mgmt (writes:1)"},
    "select_browser":         {"decision": "allow", "reason": "session routing (writes:1)"},
    "switch_browser":         {"decision": "allow", "reason": "session routing, user-confirmed in-browser (writes:1)"},
    "form_input":             {"decision": "allow", "reason": "form write (writes:3); origin-gated — allowed only into a tab known to be on an allowlisted host"},
    "upload_image":           {"decision": "allow", "reason": "image into page (writes:3); origin-gated — same rule as form_input, since screenshot+upload is a full-fidelity egress channel"},
    "gif_creator":            {"decision": "allow", "reason": "recording control (writes:1); export with coordinate or download is gated separately"},
    "file_upload":            {"decision": "ask",   "reason": "local file exfiltration channel (writes:4)"},
    "javascript_tool":        {"decision": "ask",   "reason": "arbitrary JS in page context (writes:5)"},
    "shortcuts_execute":      {"decision": "ask",   "reason": "opaque composite action (writes:4)"}
  }
}
